{
  "name": "gifstudio",
  "version": "0.6.0",
  "private": true,
  "description": "Test and release tooling for the single-file GifStudio browser app",
  "type": "module",
  "scripts": {
    "test": "npm run check:artifact && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/gif-decoder.test.mjs",
    "test:e2e": "npx --no-install playwright test",
    "test:visual": "npx --no-install playwright test --project=visual-chromium",
    "test:visual:update": "npx --no-install playwright test --project=visual-chromium --update-snapshots",
    "build:artifact": "node scripts/build-artifact.mjs --write",
    "check:artifact": "node scripts/build-artifact.mjs --check",
    "lint": "npm run check:artifact && node scripts/release-check.mjs",
    "build": "npm run check:artifact && node scripts/release-check.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "gifsicle-wasm-browser": "1.5.19",
    "pako": "2.1.0",
    "upng-js": "2.1.0"
  }
}
